# ===================================================
# Frontend Client Environment Configuration (Vercel)
# ===================================================

# The public URL of your deployed backend service (e.g., Render Web Service)
# Note: Do not add a trailing slash.
# Example: https://taskflow-api.onrender.com
#
# In local development: Leave this unset or empty to use Vite's internal proxy (/api -> localhost:5000)
VITE_API_URL=https://your-backend-api.onrender.com

# ===================================================
# Server Environment Configuration
# ===================================================
PORT=5000
NODE_ENV=production

# The exact production frontend URL (e.g. Vercel deployment URL)
# Used by Express CORS middleware to restrict cross-origin access
# Example: https://task-flow-lemon-one.vercel.app
FRONTEND_URL=https://task-flow-lemon-one.vercel.app

# ===================================================
# Hosted MySQL Database Configuration
# (e.g. Aiven, Railway, TiDB Cloud, AWS RDS, PlanetScale)
# ===================================================
DB_HOST=your-mysql-hostname.cloud.provider.com
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=task_manager_db
DB_PORT=3306

# ===================================================
# TLS / SSL Settings for Cloud Database Providers
# ===================================================
# Set to 'true' to require an encrypted TLS connection (mandatory for most cloud DBs)
DB_SSL=true

# Set to 'true' to verify CA certificate chain (recommended for production)
# Set to 'false' only if your provider uses a self-signed cert without public CA
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional: Custom CA certificate if required by your cloud provider (e.g. Aiven or AWS RDS bundle)
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
